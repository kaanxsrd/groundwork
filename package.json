{
  "name": "@vante/groundwork",
  "version": "0.1.0",
  "description": "Postgres-only, Drizzle-native building blocks for rate limiting, audit logs, scoped API keys, background jobs and idempotency keys.",
  "license": "MIT",
  "author": "Vante",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaanxsrd/groundwork.git"
  },
  "homepage": "https://github.com/kaanxsrd/groundwork#readme",
  "bugs": {
    "url": "https://github.com/kaanxsrd/groundwork/issues"
  },
  "type": "module",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "postgres",
    "postgresql",
    "rate-limit",
    "audit-log",
    "api-keys",
    "background-jobs",
    "job-queue",
    "idempotency"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit/index.d.ts",
      "default": "./dist/rate-limit/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    },
    "./api-keys": {
      "types": "./dist/api-keys/index.d.ts",
      "default": "./dist/api-keys/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "default": "./dist/jobs/index.js"
    },
    "./idempotency": {
      "types": "./dist/idempotency/index.d.ts",
      "default": "./dist/idempotency/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "biome check . && bun run typecheck && bun run test:unit",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:drift": "bun scripts/check-migrations.ts",
    "smoke": "bun run build && publint --strict && attw --pack . --profile esm-only && node scripts/smoke.mjs",
    "example": "node scripts/example.mjs",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.4",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "postgres": "4.1.1",
    "publint": "0.3.25",
    "redis": "6.3.1",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
