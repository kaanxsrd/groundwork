# Copy to .env.local and fill in. Generate each secret with: openssl rand -base64 32
DATABASE_URL=postgres://groundwork:groundwork@127.0.0.1:54330/groundwork_example
GROUNDWORK_SECRET=
# Sent as "Authorization: Bearer …" to /api/jobs. Vercel Cron sends it for you.
CRON_SECRET=
# Guards the admin routes in this example. Use your app's real sign-in instead.
ADMIN_SECRET=
