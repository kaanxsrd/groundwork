# Copy to .env to override the defaults used by docker compose and the tests.

# Host port for the Postgres container (docker-compose.yml).
POSTGRES_PORT=54330
# Postgres major for the container. CI tests 16 (oldest supported) and 18 (newest).
POSTGRES_VERSION=18

# Maintenance database the test harness connects to. It creates one database per test file.
TEST_DATABASE_URL=postgres://groundwork:groundwork@127.0.0.1:54330/groundwork
# Driver the integration tests use: postgres-js or node-postgres.
GW_TEST_DRIVER=postgres-js
